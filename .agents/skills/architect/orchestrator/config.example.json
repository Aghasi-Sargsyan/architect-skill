{
  "agyBin": "agy",
  "executor": { "model": "gemini-3.8-flash-high" },
  "architect": { "model": "gemini-4-argon-high" },
  "permissions": "allowlist",
  "blockedNpmScripts": [],
  "allowedCommands": [],
  "protectedConfigFiles": [
    "package.json",
    "tsconfig.json",
    "tsconfig.*.json",
    "vitest.config.*",
    "vite.config.*",
    "jest.config.*",
    "eslint.config.*",
    ".eslintrc*",
    "pyproject.toml",
    "pytest.ini",
    "Cargo.toml",
    "go.mod",
    "Makefile",
    "justfile"
  ],
  "bypassScanPaths": ["src", "tests"],
  "bypassPatterns": [
    "[:<,|=>&[(]\\s*any\\b",
    "\\bas\\s+any\\b",
    "as unknown as",
    "@ts-(ignore|expect-error|nocheck)",
    "eslint-disable",
    "\\.(skip|only)\\(",
    "#\\s*noqa\\b",
    "#\\s*type:\\s*ignore",
    "#\\[allow\\(",
    "(?:Object\\.assign|(?:Object|Reflect)\\.(?:defineProperty|defineProperties|setPrototypeOf))\\s*\\(\\s*(?:[A-Za-z_$][\\w$]*\\s*\\.\\s*prototype|globalThis)\\b|\\b(?:[A-Za-z_$][\\w$]*\\s*\\.\\s*prototype|globalThis)\\s*(?:\\.\\s*[A-Za-z_$][\\w$]*|\\[[^\\]]+\\])\\s*=(?!=)|(?:^|[^\\w$])__proto__\\s*(?:=(?!=)|:)"
  ],
  "testFilePatterns": [
    "(?:^|/)tests/",
    "\\.(?:test|spec)\\.[^/]+$",
    "(?:^|/)test_[^/]+\\.py$",
    "(?:^|/)[^/]+_test\\.(?:py|go)$"
  ],
  "testPatterns": [
    "\\b(?:test|it)\\s*\\(",
    "^\\s*def\\s+test_"
  ],
  "assertPatterns": [
    "\\bassert\\.",
    "\\bexpect\\s*\\(",
    "^\\s*assert\\s+\\S"
  ],
  "redCheckCommand": "node --test {file}",
  "maxFixRounds": 2,
  "maxPermissionPrompts": 5,
  "answerTimeoutMinutes": 60,
  "timeoutMinutes": 30,
  "verifyTimeoutMs": 120000,
  "notify": true
}
